# SMTP Configuration (for activation emails)
# Stalwart Mail on Podman proxy network
SMTP_HOST=stalwart
SMTP_PORT=465
SMTP_USER=pierrewagou
SMTP_PASSWORD=<your-authentik-password>
SMTP_FROM=noreply-creneau@wagou.fr

# Local dev (Mailpit) — uncomment to use local mail catcher
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=test
# SMTP_PASSWORD=test
# SMTP_FROM=noreply-creneau@wagou.fr

# --- Optional (all have safe defaults) -----------------------------
# SMTP_* is the only block required for real mail; without it the app
# starts, logs a warning, and skips sending (sendActivationEmail → false).

# SQLite URL. Defaults to file:data/creneau.db (auto-created).
# DATABASE_URL=file:data/creneau.db

# Set to "true" to copy the baked drizzle/seed.db into place on first
# boot (preview environment only — leave unset in production).
# SEED_ON_INIT=true

# Base path for the VitePress docs build (CI sets /creneau/). Default "/".
# VITEPRESS_BASE=/

# Set by the container image (Dockerfile) and docker-compose.
# NODE_ENV=production

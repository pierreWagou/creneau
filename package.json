{
	"name": "creneau",
	"private": true,
	"version": "1.6.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true && lefthook install || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --fix .",
		"check:biome": "biome check .",
		"check:biome:fix": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"release:patch": "npm version patch && git push --follow-tags",
		"release:minor": "npm version minor && git push --follow-tags",
		"release:major": "npm version major && git push --follow-tags",
		"docs:dev": "vitepress dev docs",
		"predocs:dev": "mkdir -p docs/public && cp openapi.yaml docs/public/openapi.yaml && cp static/favicon.svg docs/public/favicon.svg",
		"docs:build": "VITEPRESS_BASE=/creneau/ vitepress build docs",
		"predocs:build": "mkdir -p docs/public && cp openapi.yaml docs/public/openapi.yaml && cp static/favicon.svg docs/public/favicon.svg",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed:dev": "DATABASE_URL=file:./data/creneau.db tsx scripts/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/nodemailer": "^8.0.1",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.2.2",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.0.0",
		"typescript": "^6.0.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.7",
		"vitepress": "^1.6.3",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@event-calendar/core": "^5.7.0",
		"@floating-ui/dom": "^1.7.6",
		"@libsql/client": "^0.17.3",
		"@node-rs/argon2": "^2.0.2",
		"@sveltejs/adapter-node": "^5.5.4",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.2",
		"nodemailer": "^9.0.5",
		"qrcode": "^1.5.4",
		"svelte-dnd-action": "^0.9.80",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"xstate": "^5.33.2"
	}
}
